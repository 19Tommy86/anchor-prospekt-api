# =============================================================================
# Aina — konfigurasjon
# =============================================================================
# Kopier til .env og fyll inn det du faktisk har.
# ALT under er valgfritt. Aina starter uten en eneste nøkkel — da kjører den
# bare med færre konnektorer. Se docs/03-api-nokler.md for full begrunnelse,
# kostnad og offline-strategi per tjeneste.
#
# .env skal ALDRI committes. I produksjon: bruk SOPS/age eller Docker secrets.
# =============================================================================

# --- Kjerne -----------------------------------------------------------------
AINA_ENV=dev
AINA_HOST=0.0.0.0
AINA_PORT=8080
AINA_DATA_DIR=./data
AINA_HOUSEHOLD_PACK=./packs/husstand.yaml
AINA_LOG_LEVEL=INFO

# Identifiserer noden. Brukes i lisens, backup og logg.
AINA_NODE_ID=node-01

# --- Identitet mot åpne norske API-er ---------------------------------------
# MET Norway (api.met.no) krever INGEN nøkkel, men avviser kall uten en
# identifiserende User-Agent med kontaktinfo. Dette er ikke valgfritt i praksis.
AINA_USER_AGENT="aina/0.1 (kontakt@example.com)"

# --- Posisjon (fallback hvis husstandsprofilen ikke er lastet) ---------------
AINA_LAT=59.9139
AINA_LON=10.7522
AINA_ALTITUDE=20

# --- Strøm: Tibber ----------------------------------------------------------
# Personlig token: https://developer.tibber.com/settings/access-token
# Gratis for Tibber-kunder. Pulse gir sanntidsforbruk lokalt over MQTT/LAN,
# som fortsatt virker når internett er nede.
TIBBER_TOKEN=

# Alternativ uten Tibber-abonnement: hvakosterstrommen.no — ingen nøkkel.
# Sett prisområdet ditt: NO1 NO2 NO3 NO4 NO5
AINA_PRISOMRADE=NO1

# --- Bil --------------------------------------------------------------------
# Velg ÉN strategi. Se docs/03-api-nokler.md § Bil.
# a) Enode (aggregator, dekker de fleste merker, betalt)
ENODE_CLIENT_ID=
ENODE_CLIENT_SECRET=
# b) Smartcar (aggregator, gratis utviklingsnivå)
SMARTCAR_CLIENT_ID=
SMARTCAR_CLIENT_SECRET=
# c) Tesla Fleet API (krever registrert app + eget domene med public key)
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=

# --- Kalender ---------------------------------------------------------------
# Anbefalt: lokal CalDAV-server (Radicale) — fungerer 100 % offline.
CALDAV_URL=http://radicale:5232/
CALDAV_USERNAME=
CALDAV_PASSWORD=
# Valgfri toveis-sync mot Google (OAuth 2.0 desktop client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Utgående meldinger -----------------------------------------------------
# E-post: egen SMTP er å foretrekke (ingen tredjepart ser familiens post)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Aina <aina@example.com>"

# SMS — velger du en norsk leverandør slipper du US-ruting. Se docs/03.
SVEVE_USERNAME=
SVEVE_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Språkmodell ------------------------------------------------------------
# Lokal modell er standard og eneste modell som brukes i beredskapsnivå >= GUL.
OLLAMA_URL=http://ollama:11434
AINA_LOCAL_MODEL=qwen2.5:7b-instruct
AINA_LOCAL_MODEL_LAV_EFFEKT=qwen2.5:3b-instruct

# Sky-modell brukes KUN i nivå GRØNN, og kun hvis policy tillater det.
ANTHROPIC_API_KEY=
AINA_CLOUD_MODEL=claude-sonnet-5
AINA_CLOUD_ALLOWED=true

# --- Stemme (alt lokalt, ingen nøkler) --------------------------------------
WYOMING_STT_URI=tcp://whisper:10300
WYOMING_TTS_URI=tcp://piper:10200
WYOMING_WAKEWORD_URI=tcp://openwakeword:10400
AINA_WAKEWORD=hei_aina
AINA_TTS_VOICE=nb_NO-talesyntese-medium

# --- Enhetslag --------------------------------------------------------------
# Home Assistant håndterer Z-Wave/Zigbee/Matter/varmepumpe/lys.
HOMEASSISTANT_URL=http://homeassistant:8123
HOMEASSISTANT_TOKEN=

# MQTT-buss for sensorer, Pulse, UPS og Meshtastic
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Strømforsyning / UPS ---------------------------------------------------
# NUT (Network UPS Tools) leser batteristatus. Driver beredskapsnivåene.
NUT_HOST=127.0.0.1
NUT_UPS_NAME=aina
# Terskler i prosent for nivåbytte ved batteridrift
AINA_BATTERI_ORANSJE=60
AINA_BATTERI_ROD=25

# --- Nettverksovervåking ----------------------------------------------------
# Verter som pinges for å avgjøre om internett faktisk finnes.
AINA_HELSESJEKK_VERTER=1.1.1.1,9.9.9.9,api.met.no
AINA_HELSESJEKK_INTERVALL_S=30
